@model Event_Ease.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<h1>Delete</h1>

<h3 class="text-danger">Are you sure you want to delete this booking?</h3>
<div>
    <h4>Booking</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Venue</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Venue.Name)</dd>

        <dt class="col-sm-2">Event</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Event.Name)</dd>

        <dt class="col-sm-2">Booking Date</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.BookingDate)</dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </form>
</div>