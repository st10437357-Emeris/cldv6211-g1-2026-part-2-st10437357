@model Event_Ease.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h1>Details</h1>

<div>
    <h4>Booking</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Venue</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Venue.Name)</dd>

        <dt class="col-sm-2">Event</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Event.Name)</dd>

        <dt class="col-sm-2">Booking Date</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.BookingDate)</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>