@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-2">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm" style="border-left: 5px solid #0d6efd;">
        <div class="container-fluid py-2">
            <h1 class="display-5 fw-bold text-primary">Welcome to Event Ease</h1>
            <p class="col-md-8 fs-4 text-muted mt-3">
                Your central command hub. Manage your world-class events, track venue capacities, and ensure seamless bookings all from one place.
            </p>
        </div>
    </div>

    <div class="row align-items-md-stretch mt-4">

        <div class="col-md-6 mb-4">
            <div class="h-100 p-5 text-white bg-dark rounded-3 shadow hover-card">
                <h2><i class="bi bi-calendar-event"></i> Manage Events</h2>
                <p class="mt-3">Create new events, update schedules, and upload stunning promotional images for your upcoming lineup.</p>
                <a asp-controller="Events" asp-action="Index" class="btn btn-outline-light mt-3">View Events Hub</a>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="h-100 p-5 bg-white border rounded-3 shadow-sm hover-card">
                <h2 class="text-dark"><i class="bi bi-journal-check"></i> Track Bookings</h2>
                <p class="text-muted mt-3">Review current reservations, manage your venues, and prevent double-booking conflicts effortlessly.</p>
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-primary mt-3">Manage Bookings</a>
            </div>
        </div>

    </div>
</div>